# Copy to .env.local and fill in. .env.local is gitignored.

# RPC endpoint for Ethereum Sepolia (chainId 11155111).
# Public option: https://ethereum-sepolia-rpc.publicnode.com
# Or get a dedicated key from Alchemy / Infura for higher rate limits.
RPC_URL=

# --- optional ---

# Comma-separated IPFS gateways to try in order for ipfs:// agent URIs. A
# gateway that times out, errors, or exhausts its 429 retries falls through
# to the next one.
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/,https://cloudflare-ipfs.com/ipfs/

# Timeout for the first gateway attempt, and for plain https:// URIs (ms).
# Default: 10000
# FETCH_TIMEOUT_MS=10000

# Timeout for each fallback gateway attempt after the first (ms) — longer,
# since a slow-but-alive gateway beats moving on too soon. Default: 20000
# IPFS_RETRY_TIMEOUT_MS=20000

# Minimum ms between requests to an IPFS gateway, with backoff-retry on 429
# within a gateway before falling through to the next one. Default: 300
# IPFS_DELAY_MS=300

# Enumeration mode: "probe" (default) binary-searches the highest minted
# agentId for the true total, then reads tokenURI(START_ID..START_ID+MAX_AGENTS).
# "logs" instead reads Registered events over [START_BLOCK, latest] in chunks —
# slower and RPC-range-limited, but gives exact per-agent registration data
# for a bounded window.
# ENUM_MODE=probe

# probe mode: first agentId in the sample window (default: 1)
# START_ID=1

# Max number of agents to resolve metadata for in one run (default: 200).
# MAX_AGENTS=200

# logs mode only: block to start scanning Registered events from (default: 0)
# START_BLOCK=0
