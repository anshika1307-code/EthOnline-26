# Copy to .env.local and fill in. .env.local is gitignored.

# RPC endpoint for Ethereum Sepolia (chainId 11155111).
# Public option: https://ethereum-sepolia-rpc.publicnode.com
# Or get a dedicated key from Alchemy / Infura for higher rate limits.
RPC_URL=

# --- optional ---

# IPFS gateway for resolving ipfs:// agent URIs (default: https://ipfs.io/ipfs/)
# IPFS_GATEWAY=https://ipfs.io/ipfs/

# Minimum ms between requests to the IPFS gateway, with backoff-retry on 429
# (the public ipfs.io gateway rate-limits aggressively). Default: 300
# IPFS_DELAY_MS=300

# Enumeration mode: "probe" (default) binary-searches the highest minted
# agentId for the true total, then reads tokenURI(START_ID..START_ID+MAX_AGENTS).
# "logs" instead reads Registered events over [START_BLOCK, latest] in chunks —
# slower and RPC-range-limited, but gives exact per-agent registration data
# for a bounded window.
# ENUM_MODE=probe

# probe mode: first agentId in the sample window (default: 1)
# START_ID=1

# Max number of agents to resolve metadata for in one run (default: 200).
# MAX_AGENTS=200

# logs mode only: block to start scanning Registered events from (default: 0)
# START_BLOCK=0
