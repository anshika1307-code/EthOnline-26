# Preflight API — the safety check sold per call.
# Copy to .env locally; on a host, set these as environment variables.

# Hedera account that RECEIVES payments for checks.
HEDERA_RECEIVER_ACCOUNT_ID=0.0.0000000

# Blocky402 facilitator. NOTE: https://blocky402.com/ is the marketing site,
# not the API — pointing at it 404s and every gated route then 500s.
FACILITATOR_URL=https://api.testnet.blocky402.com
FACILITATOR_TIMEOUT_MS=30000

HEDERA_NETWORK=hedera:testnet

# Price per check, in TINYBARS. 100000 = 0.001 HBAR, a fraction of a cent.
PRICE_TINYBAR=100000

# Most hosts inject PORT themselves; this is the local default.
PORT=8403

# --- optional: verifiable payment audit trail on HCS ---
# One receipt per settled check. Leave unset to disable.
# HCS_OPERATOR_KEY is a SECRET — set it in your host's env settings, never commit.
# HCS_TOPIC_ID=0.0.10519901
# HCS_OPERATOR_ID=0.0.0000000
# HCS_OPERATOR_KEY=0x...
