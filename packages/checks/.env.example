# Preflight check suite. Copy to .env for the payment-spending checks.

# --- P4 (delivery) and A1 (replay): the buyer account that actually pays ---
# ECDSA key, 0x-prefixed, from https://portal.hedera.com/ (Testnet).
HEDERA_CLIENT_ACCOUNT_ID=0.0.0000000
HEDERA_CLIENT_PRIVATE_KEY=0x...

HEDERA_NETWORK=hedera:testnet
HBAR_ASSET=0.0.0

# Hard per-payment cap in TINYBARS, enforced before anything is signed.
# 2000000 = 0.02 HBAR. An endpoint quoting above this is refused, not paid.
MAX_AMOUNT_PER_PAYMENT=2000000

# --- ETHICS: hosts A1 (and any future Group A check) may run against ---
# Comma-separated. localhost and 127.0.0.1 are always allowed.
# ONCE THE TESTBED IS DEPLOYED, ADD ITS HOSTNAME HERE or A1 will correctly
# refuse to run against your own service:
#   OWN_TESTBED_HOSTS=preflight-testbed.onrender.com
# Never add a host you do not control. See ETHICS.md §1 rule 2.
OWN_TESTBED_HOSTS=
