{
  "name": "preflight-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preflight check suite. Group P (passive, safe against anyone) and Group A (active, our own testbed only).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "p4": "tsx src/bin/run-p4.ts",
    "a1": "tsx src/bin/run-a1.ts",
    "p1": "tsx src/bin/run-p1.ts",
    "report": "tsx src/bin/run-report.ts"
  },
  "dependencies": {
    "@x402/core": "~2.25.0",
    "@x402/fetch": "~2.25.0",
    "@x402/hedera": "~2.25.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
