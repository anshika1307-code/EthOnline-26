# Copy to .env and fill in from https://portal.hedera.com/ (Testnet).
# Keys must be ECDSA and 0x-prefixed — the x402 Hedera scheme assumes ECDSA.

# The account that RECEIVES payments (payTo).
HEDERA_RECEIVER_ACCOUNT_ID=0.0.0000000

# The facilitator. Verifies payloads, pays gas, submits the transaction.
# Blocky402 is the facilitator Hedera's prize track requires.
#
# NOTE: the prize page links https://blocky402.com/ — that is the MARKETING
# SITE, not the API. Pointing this at it 404s (with a Next.js page dumped into
# the error) and every gated route then 500s instead of returning 402.
# Real API bases:
#   testnet  https://api.testnet.blocky402.com   <- hedera:testnet
#   mainnet  https://api.blocky402.com           <- hedera:mainnet only
FACILITATOR_URL=https://api.testnet.blocky402.com
FACILITATOR_TIMEOUT_MS=30000

# hedera:testnet | hedera:mainnet
HEDERA_NETWORK=hedera:testnet

# Price per call, in TINYBARS. 1 HBAR = 100_000_000 tinybars.
# 1_000_000 tinybars = 0.01 HBAR.
PRICE_TINYBAR=1000000

PORT=8402

# --- client side only (packages/checks P4 delivery check, not this server) ---
# HEDERA_CLIENT_ACCOUNT_ID=0.0.0000000
# HEDERA_CLIENT_PRIVATE_KEY=0x...
